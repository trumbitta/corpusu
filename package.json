{
  "name": "@corpusu/source",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build",
    "build:sample": "tsc src/sample/main.tsx --outDir dist/sample --module nodenext --moduleResolution nodenext --target es2022 --jsx react-jsx --esModuleInterop true --resolveJsonModule true --skipLibCheck true --emitDeclarationOnly false",
    "build:sample:bundle": "esbuild src/sample/main.tsx --bundle --platform=node --target=node24 --outfile=dist/sample-bundle.mjs --format=esm --external:react-devtools-core --external:ink --external:ink-big-text --external:react --external:react-dom --external:react-reconciler",
    "build:sample:rollup": "vite build --config vite.sample.config.ts",
    "start:sample": "npm run build:sample:rollup && node dist/main.js",
    "start:sample:plain": "node scripts/run-plain.mjs",
    "typecheck": "tsc -b"
  },
  "private": false,
  "dependencies": {
    "rxjs": "^7.8.2",
    "zod": "^4.1.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ink": "^6.5.1",
    "ink-big-text": "^1.1.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "^18.16.9",
    "@types/react": "^19.0.0",
    "esbuild": "^0.19.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^2.6.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.29.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "~4.5.0",
    "tsx": "^4.0.0"
  }
}
